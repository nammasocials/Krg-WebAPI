<?xml version="1.0" encoding="utf-8"?>
<!--
  Invoice report. Rendered to PDF by DBLayer\Service\InvoiceReportService.cs.

  The "InvoiceItems" dataset is bound to IEnumerable<DBLayer.ViewModels.VInvoiceReportItem>,
  so the Field names below must match that class's property names. Everything on
  the invoice header is passed as a report parameter instead.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2010/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="InvoiceDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString>/* Local Connection */</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>1a0d9f66-4a49-4b2a-9d0e-9a0e5c4a1b01</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="InvoiceItems">
      <Query>
        <DataSourceName>InvoiceDataSource</DataSourceName>
        <CommandText>/* Local Query */</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SlNo"><DataField>SlNo</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="ProductName"><DataField>ProductName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="HsnCode"><DataField>HsnCode</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Quantity"><DataField>Quantity</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="UnitCost"><DataField>UnitCost</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Cost"><DataField>Cost</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="CentralGst"><DataField>CentralGst</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="CentralGstAmount"><DataField>CentralGstAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="StateGst"><DataField>StateGst</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="StateGstAmount"><DataField>StateGstAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="NetProductAmount"><DataField>NetProductAmount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
      <rd:DataSetInfo>
        <rd:DataSetName>VInvoiceReportItem</rd:DataSetName>
        <rd:TableName>VInvoiceReportItem</rd:TableName>
        <rd:ObjectDataSourceType>DBLayer.ViewModels.VInvoiceReportItem, DBLayer</rd:ObjectDataSourceType>
      </rd:DataSetInfo>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="InvoiceNo"><DataType>String</DataType><Prompt>Invoice No</Prompt></ReportParameter>
    <ReportParameter Name="InvoiceDate"><DataType>String</DataType><Prompt>Invoice Date</Prompt></ReportParameter>
    <ReportParameter Name="CustomerName"><DataType>String</DataType><Prompt>Customer Name</Prompt></ReportParameter>
    <ReportParameter Name="CustomerEmail"><DataType>String</DataType><Nullable>true</Nullable><Prompt>Customer Email</Prompt></ReportParameter>
    <ReportParameter Name="CustomerGst"><DataType>String</DataType><Nullable>true</Nullable><Prompt>Customer GST</Prompt></ReportParameter>
    <ReportParameter Name="CompanyName"><DataType>String</DataType><Prompt>Company Name</Prompt></ReportParameter>
    <ReportParameter Name="CompanyAddress"><DataType>String</DataType><Nullable>true</Nullable><Prompt>Company Address</Prompt></ReportParameter>
    <ReportParameter Name="CompanyGst"><DataType>String</DataType><Nullable>true</Nullable><Prompt>Company GST</Prompt></ReportParameter>
    <ReportParameter Name="TotalCost"><DataType>String</DataType><Prompt>Total Cost</Prompt></ReportParameter>
  </ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Textbox Name="TxtTitle">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>TAX INVOICE</Value>
                    <Style><FontFamily>Arial</FontFamily><FontSize>16pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color></Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Center</TextAlign></Style>
              </Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtTitle</rd:DefaultName>
            <Top>0in</Top><Left>0in</Left><Height>0.35in</Height><Width>7.3in</Width>
            <Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
          </Textbox>
          <Textbox Name="TxtCompany">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph><TextRuns><TextRun><Value>=Parameters!CompanyName.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=Parameters!CompanyAddress.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=IIf(Len(Parameters!CompanyGst.Value) = 0, "", "GSTIN: " &amp; Parameters!CompanyGst.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtCompany</rd:DefaultName>
            <Top>0.45in</Top><Left>0in</Left><Height>0.8in</Height><Width>4.2in</Width>
            <Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
          </Textbox>
          <Textbox Name="TxtInvoiceMeta">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph><TextRuns><TextRun><Value>="Invoice No: " &amp; Parameters!InvoiceNo.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>="Date: " &amp; Parameters!InvoiceDate.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtInvoiceMeta</rd:DefaultName>
            <Top>0.45in</Top><Left>4.2in</Left><Height>0.8in</Height><Width>3.1in</Width>
            <Style><Border><Style>None</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight><PaddingTop>2pt</PaddingTop><PaddingBottom>2pt</PaddingBottom></Style>
          </Textbox>
          <Textbox Name="TxtBillTo">
            <CanGrow>true</CanGrow>
            <KeepTogether>true</KeepTogether>
            <Paragraphs>
              <Paragraph><TextRuns><TextRun><Value>BILL TO</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color></Style></TextRun></TextRuns><Style /></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=Parameters!CustomerName.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>11pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=Parameters!CustomerEmail.Value</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph>
              <Paragraph><TextRuns><TextRun><Value>=IIf(Len(Parameters!CustomerGst.Value) = 0, "", "GSTIN: " &amp; Parameters!CustomerGst.Value)</Value><Style><FontFamily>Arial</FontFamily><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph>
            </Paragraphs>
            <rd:DefaultName>TxtBillTo</rd:DefaultName>
            <Top>1.35in</Top><Left>0in</Left><Height>0.95in</Height><Width>7.3in</Width>
            <Style><Border><Style>Solid</Style><Color>#BFBFBF</Color><Width>1pt</Width></Border><BackgroundColor>#F2F5FA</BackgroundColor><PaddingLeft>4pt</PaddingLeft><PaddingRight>4pt</PaddingRight><PaddingTop>3pt</PaddingTop><PaddingBottom>3pt</PaddingBottom></Style>
          </Textbox>
